{
  "version": 1,
  "_comment": "NodeError v1 공통 오류 catalog (ADR-0016). 정본은 이 파일 하나다 — backend/node_errors/catalog.py 가 읽고 검증하며, frontend/src/generated/errorCatalog.json 과 Documents/ERROR_CATALOG.md 는 `python backend/export_node_definitions.py` 가 여기서 만든다. code 는 SCREAMING_SNAKE_CASE 의 DOMAIN_REASON, 사용자 조치나 제품 처리 방식이 다를 때만 나눈다. 출시한 code 의 의미는 바꾸지 않는다 — 제거할 땐 deprecated=true 와 replacedBy 를 한 릴리스 이상 유지한다.",
  "categories": {
    "credential": {
      "label": "자격증명",
      "icon": "key-round",
      "description": "API 센터의 연결·권한·갱신이 필요한 오류"
    },
    "validation": {
      "label": "입력 검증",
      "icon": "alert-circle",
      "description": "외부 호출 전에 노드 입력이 잘못된 오류"
    },
    "artifact": {
      "label": "파일",
      "icon": "file-warning",
      "description": "생성·업로드 파일 참조가 유효하지 않은 오류"
    },
    "database": {
      "label": "데이터베이스",
      "icon": "database",
      "description": "Database Query 연결·쿼리 오류"
    },
    "delivery": {
      "label": "발송",
      "icon": "send",
      "description": "Discord·이메일 등 외부 발송 오류 — effectState 확인 뒤 재시도"
    },
    "connector": {
      "label": "연동",
      "icon": "plug",
      "description": "공식 연동 서비스 호출 오류"
    },
    "timeout": {
      "label": "시간 초과",
      "icon": "history",
      "description": "응답을 제한 시간 안에 받지 못한 오류"
    },
    "runtime": {
      "label": "실행",
      "icon": "bug",
      "description": "실행 엔진 내부 오류 — 요청 ID 로 진단"
    }
  },
  "resolutions": {
    "open_api_center": {
      "label": "API 센터에서 연결",
