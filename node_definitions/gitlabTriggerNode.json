{
  "type": "gitlabTriggerNode",
  "version": 1,
  "category": "trigger",
  "display": {
    "label": "GitLab 이벤트 수신",
    "icon": "provider-gitlab",
    "color": "#FC6D26"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "out",
      "dataType": "json"
    }
  ],
  "fields": [
    {
      "name": "webhookUrl",
      "kind": "text",
      "label": "수신 주소 (GitLab 웹훅 URL 의 경로)",
      "placeholder": "/webhook/gitlab-acme-site (비우면 프로젝트 번호)"
    },
    {
      "name": "events",
      "kind": "text",
      "label": "받을 이벤트 (object_kind, 쉼표로 구분, 비우면 전부)",
      "placeholder": "merge_request, issue, pipeline"
    },
    {
      "name": "actionFilter",
      "kind": "text",
      "label": "action 필터 (쉼표로 구분, 비우면 전부)",
      "placeholder": "open, reopen, update, merge, close, approved"
    },
    {
      "name": "branchFilter",
      "kind": "text",
      "label": "브랜치 필터 (glob, 쉼표로 구분)",
      "placeholder": "main, release/*"
    },
    {
      "name": "labelFilter",
      "kind": "text",
      "label": "라벨 필터 (쉼표로 구분)",
      "placeholder": "bug, needs-review"
    },
    {
      "name": "verifyMode",
      "kind": "select",
      "label": "요청 검증",
      "default": "static_token",
      "options": [
        {
          "value": "static_token",
          "label": "Secret token 헤더 X-Gitlab-Token (= API 센터 '웹훅 서명 비밀')"
        },
        {
          "value": "none",
          "label": "없음 — 테스트용. URL 을 아는 누구나 실행"
        }
      ]
    }
  ],
  "credentials": [
    {
      "name": "webhook_secret",
      "provider": "webhook_secret",
      "optional": true
    }
  ],
  "capabilities": [],
  "sideEffect": "none",
  "executor": "gitlabTriggerNode",
  "mock": {
    "samples": [
      {
