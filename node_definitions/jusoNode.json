                },
                "sigungu": {
                  "type": "string"
                },
                "eupmyeondong": {
                  "type": "string"
                },
                "roadName": {
                  "type": "string"
                },
                "raw": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "docsUrl": "https://business.juso.go.kr/addrlink/openApi/apiExprn.do",
    "verifiedAt": null
  },
