{
  "type": "jusoNode",
  "version": 1,
  "category": "integration",
  "display": {
    "label": "도로명주소",
    "icon": "provider-juso",
    "color": "#0b6bcb"
  },
  "inputs": [
    {
      "name": "in",
      "dataType": "any"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "dataType": "json"
    }
  ],
  "fields": [
    {
      "name": "keyword",
      "kind": "text",
      "label": "찾을 주소",
      "placeholder": "예: 부산대학로63번길 2",
      "validation": [],
      "ui": {
        "help": "비워두면 직전 노드가 준 값을 주소로 씁니다."
      }
    },
    {
      "name": "count",
      "kind": "number",
      "label": "가져올 개수",
      "default": 10,
      "validation": [
        {
          "rule": "number",
          "message": "{node_id}(jusoNode)의 count는 숫자여야 한다"
        }
      ]
    },
    {
      "name": "includeHistory",
      "kind": "checkbox",
      "label": "옛 주소도 함께 찾기",
      "default": false,
      "ui": {
        "help": "행정구역 개편 전 주소로 검색해야 할 때 켭니다."
      }
    }
  ],
  "credentials": [
    {
      "name": "juso",
      "provider": "juso",
      "optional": false
    }
  ],
  "capabilities": [
    "network"
  ],
  "sideEffect": "external-read",
  "executor": "jusoNode",
  "connector": {
    "service": "도로명주소",
    "role": "action",
    "modes": [
      "search"
    ],
    "credentials": [
      {
        "provider": "juso",
        "scopes": []
      }
    ],
    "baseUrl": "https://business.juso.go.kr/addrlink/addrLinkApi.do",
    "timeoutSeconds": 15.0,
    "rateLimit": {
      "requestsPerMinute": 60
    },
    "retryPolicy": {
      "maxAttempts": 3,
      "baseDelaySeconds": 1.0,
      "maxDelaySeconds": 20.0
    },
    "sideEffectByMode": {
      "search": "external-read"
    },
    "errorStyle": "body",
    "outputSchemaByMode": {
      "search": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "keyword": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "countPerPage": {
            "type": "number"
          },
          "attribution": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "roadAddress": {
                  "type": "string"
                },
                "roadAddressPart1": {
                  "type": "string"
                },
                "roadAddressPart2": {
                  "type": "string"
                },
                "jibunAddress": {
                  "type": "string"
                },
                "englishAddress": {
                  "type": "string"
                },
                "zipCode": {
                  "type": "string"
                },
                "buildingName": {
