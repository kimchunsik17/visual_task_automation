{
  "type": "jandiNode",
  "version": 1,
  "category": "integration",
  "display": {
    "label": "잔디 발송",
    "icon": "provider-jandi",
    "color": "#00C473"
  },
  "inputs": [
    {
      "name": "in",
      "dataType": "any"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "dataType": "text"
    }
  ],
  "fields": [
    {
      "name": "message",
      "kind": "textarea",
      "label": "메시지 (비우면 직전 노드 출력, 채우면 뒤에 직전 출력을 덧붙임)",
      "placeholder": "{{last_result}} 로 자리를 정할 수도 있습니다",
      "ui": {
        "draggable": true
      }
    },
    {
      "name": "title",
      "kind": "text",
      "label": "정보 카드 제목 (선택)",
      "placeholder": "예: 배포 완료"
    },
    {
      "name": "description",
      "kind": "text",
      "label": "정보 카드 설명 (선택)",
      "placeholder": "예: v2.3.0 · 2분 소요"
    },
    {
      "name": "link",
      "kind": "text",
      "label": "링크 (선택, 설명이 비면 설명 자리에)",
      "placeholder": "https://…"
    },
    {
      "name": "color",
      "kind": "select",
      "label": "색",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "기본"
        },
        {
          "value": "green",
          "label": "초록"
        },
        {
          "value": "blue",
          "label": "파랑"
        },
        {
          "value": "yellow",
          "label": "노랑"
        },
        {
          "value": "red",
          "label": "빨강"
        },
        {
          "value": "gray",
          "label": "회색"
        }
      ]
    }
  ],
  "credentials": [
    {
      "name": "jandi_webhook",
      "provider": "jandi_webhook",
      "optional": false
    }
  ],
  "capabilities": [
    "network"
  ],
  "sideEffect": "external-write",
  "executor": "jandiNode",
  "connector": {
    "service": "잔디",
    "role": "action",
    "modes": [
      "send"
    ],
    "credentials": [
      {
        "provider": "jandi_webhook",
        "scopes": []
      }
    ],
    "timeoutSeconds": 10.0,
    "retryPolicy": {
      "maxAttempts": 2,
      "baseDelaySeconds": 1.0,
      "maxDelaySeconds": 10.0
    },
    "sideEffectByMode": {
      "send": "external-write"
    },
    "docsUrl": "https://support.jandi.com/hc/ko"
  },
  "mock": {
    "scenarios": {
      "success": {
        "responses": [
          {
            "status": 200,
            "body": {}
          }
        ]
      },
      "auth_failed": {
        "responses": [
          {
            "status": 401,
            "body": {
              "code": 40100,
              "msg": "Unauthorized"
            }
          }
        ]
      },
      "rate_limited": {
        "responses": [
          {
            "status": 429,
            "headers": {
              "Retry-After": "10"
            },
            "body": {
              "code": 42900,
              "msg": "Too Many Requests"
            }
          }
        ]
      },
      "timeout": {
        "responses": [
          {
            "raise": "timeout"
          }
        ]
      }
    }
  },
  "llm": {
    "description": "잔디(JANDI) 토픽에 메시지를 보낸다(Incoming Webhook 커넥트). Slack 발송과 같은 규약 — data.message(문자열, 선택)를 비우면 직전 노드 출력을 보내고,\n                   채우면 메시지 뒤에 직전 출력을 덧붙인다({{last_result}} 로 자리를 정할 수도 있다). data.title·data.description(문자열, 선택 — 정보 카드), data.link(문자열, 선택),\n                   data.color(\"green\"|\"blue\"|\"yellow\"|\"red\"|\"gray\", 선택). API 센터에 '잔디 Incoming Webhook URL' 이 등록되어 있어야 한다. 출력은 실제로 보낸 메시지 텍스트.\n"
  }
}
