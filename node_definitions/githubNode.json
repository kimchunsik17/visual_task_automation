{
  "type": "githubNode",
  "version": 1,
  "category": "integration",
  "display": {
    "label": "GitHub",
    "icon": "provider-github",
    "color": "#8250df"
  },
  "inputs": [
    {
      "name": "in",
      "dataType": "any"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "dataType": "json"
    }
  ],
  "fields": [
    {
      "name": "mode",
      "kind": "select",
      "label": "동작",
      "default": "pr.get",
      "options": [
        {
          "value": "issue.create",
          "label": "이슈 만들기"
        },
        {
          "value": "issue.comment",
          "label": "이슈에 코멘트"
        },
        {
          "value": "issue.labels",
          "label": "이슈 라벨 추가·교체·제거"
        },
        {
          "value": "issue.update",
          "label": "이슈 수정 (제목·본문·상태)"
        },
        {
          "value": "pr.get",
          "label": "PR 정보 조회"
        },
        {
          "value": "pr.diff",
          "label": "PR diff 가져오기"
        },
        {
          "value": "pr.merge",
          "label": "PR 머지"
        },
        {
          "value": "pr.comment",
          "label": "PR 에 코멘트"
        },
        {
          "value": "release.create",
          "label": "릴리스 만들기"
        },
        {
          "value": "release.generate_notes",
          "label": "릴리스 노트 생성 (커밋·PR 기반)"
        },
        {
          "value": "workflow.dispatch",
          "label": "Actions 워크플로우 실행"
        },
        {
          "value": "dependabot.list",
          "label": "Dependabot 취약점 알림 조회"
        },
        {
          "value": "file.get",
          "label": "파일 내용 읽기"
        }
      ],
      "validation": [
        {
          "rule": "required",
          "message": "{node_id}(githubNode)에 mode가 없다"
        },
        {
          "rule": "enum",
          "message": "{node_id}(githubNode)의 mode가 허용값이 아니다"
        }
      ]
    },
    {
      "name": "repo",
      "kind": "text",
      "label": "저장소 (owner/repo)",
      "placeholder": "acme/site — 비우면 직전 GitHub 트리거 출력의 repo"
    },
    {
      "name": "number",
      "kind": "text",
      "label": "이슈/PR 번호",
      "placeholder": "42 — 비우면 직전 GitHub 트리거 출력의 number",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "issue.comment",
          "issue.labels",
          "issue.update",
          "pr.get",
          "pr.diff",
          "pr.merge",
          "pr.comment"
        ]
      }
    },
    {
      "name": "title",
      "kind": "text",
      "label": "제목 (릴리스는 표시 이름)",
      "placeholder": "이슈 제목 / 릴리스 이름",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "issue.create",
          "issue.update",
          "release.create"
        ]
      }
    },
    {
      "name": "body",
      "kind": "textarea",
      "label": "본문 (코멘트·새 이슈는 비우면 직전 노드 출력)",
      "placeholder": "마크다운. {{last_result}} 로 직전 노드 출력을 끼워 넣을 수 있습니다",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "issue.create",
          "issue.comment",
          "issue.update",
          "pr.comment",
          "release.create"
        ]
      }
    },
    {
      "name": "labels",
      "kind": "text",
      "label": "라벨 (쉼표로 구분)",
      "placeholder": "bug, priority:high",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "issue.create",
          "issue.labels",
          "issue.update"
        ]
      }
    },
    {
      "name": "labelAction",
      "kind": "select",
      "label": "라벨 동작",
      "default": "add",
      "options": [
        {
          "value": "add",
          "label": "추가"
        },
        {
          "value": "set",
          "label": "교체 (이 라벨들만 남김)"
        },
        {
          "value": "remove",
          "label": "제거"
        }
      ],
      "showWhen": {
        "field": "mode",
        "equals": "issue.labels"
      }
    },
    {
      "name": "assignees",
      "kind": "text",
      "label": "담당자 (GitHub 로그인, 쉼표로 구분)",
      "placeholder": "octocat, jane-doe",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "issue.create",
          "issue.update"
        ]
      }
    },
    {
      "name": "state",
      "kind": "select",
      "label": "상태",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "변경 없음"
        },
        {
          "value": "open",
          "label": "열기 (open)"
        },
        {
          "value": "closed",
          "label": "닫기 (closed)"
        }
      ],
      "showWhen": {
        "field": "mode",
        "equals": "issue.update"
      }
    },
    {
      "name": "mergeMethod",
      "kind": "select",
      "label": "머지 방식",
      "default": "squash",
      "options": [
        {
          "value": "merge",
          "label": "merge commit"
        },
        {
          "value": "squash",
          "label": "squash"
        },
        {
          "value": "rebase",
          "label": "rebase"
        }
      ],
      "showWhen": {
        "field": "mode",
        "equals": "pr.merge"
      }
    },
    {
      "name": "commitTitle",
      "kind": "text",
      "label": "머지 커밋 제목 (선택)",
      "placeholder": "비우면 GitHub 기본값",
      "showWhen": {
        "field": "mode",
        "equals": "pr.merge"
      }
    },
    {
      "name": "tagName",
      "kind": "text",
      "label": "태그",
      "placeholder": "v1.2.0 — 비우면 직전 GitHub 트리거 출력의 tag",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "release.create",
          "release.generate_notes"
        ]
      }
    },
    {
      "name": "targetCommitish",
      "kind": "text",
      "label": "대상 브랜치/커밋 (선택)",
      "placeholder": "main",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "release.create",
          "release.generate_notes"
        ]
      }
    },
    {
      "name": "previousTagName",
      "kind": "text",
      "label": "이전 태그 (선택 — 비우면 GitHub 이 직전 릴리스를 고른다)",
      "placeholder": "v1.1.0",
      "showWhen": {
        "field": "mode",
        "equals": "release.generate_notes"
      }
    },
    {
      "name": "draft",
      "kind": "checkbox",
      "label": "초안(draft)으로 만들기",
      "default": false,
      "showWhen": {
        "field": "mode",
        "equals": "release.create"
      }
    },
    {
      "name": "prerelease",
      "kind": "checkbox",
      "label": "프리릴리스로 표시",
      "default": false,
      "showWhen": {
        "field": "mode",
        "equals": "release.create"
      }
    },
    {
      "name": "generateNotes",
      "kind": "checkbox",
      "label": "본문이 비면 릴리스 노트를 GitHub 이 자동 생성",
      "default": true,
      "showWhen": {
        "field": "mode",
        "equals": "release.create"
      }
    },
    {
      "name": "workflowId",
      "kind": "text",
      "label": "워크플로우 파일명 또는 id",
      "placeholder": "deploy.yml",
      "showWhen": {
        "field": "mode",
        "equals": "workflow.dispatch"
      }
    },
    {
      "name": "ref",
      "kind": "text",
      "label": "브랜치/태그/커밋 (ref)",
      "placeholder": "main",
      "showWhen": {
        "field": "mode",
        "oneOf": [
          "workflow.dispatch",
          "file.get"
        ]
      }
    },
    {
      "name": "inputs",
      "kind": "json",
      "label": "워크플로우 inputs (JSON 객체, 최대 25개)",
      "placeholder": "{\"environment\": \"staging\"}",
      "showWhen": {
        "field": "mode",
        "equals": "workflow.dispatch"
      }
    },
    {
      "name": "path",
      "kind": "text",
      "label": "파일 경로",
      "placeholder": "README.md 또는 docs/CHANGELOG.md",
      "showWhen": {
        "field": "mode",
        "equals": "file.get"
      }
    },
    {
      "name": "alertState",
      "kind": "select",
      "label": "알림 상태",
      "default": "open",
      "options": [
        {
          "value": "open",
          "label": "open"
        },
        {
          "value": "dismissed",
          "label": "dismissed"
        },
        {
          "value": "fixed",
          "label": "fixed"
        },
        {
          "value": "auto_dismissed",
          "label": "auto_dismissed"
        }
      ],
      "showWhen": {
        "field": "mode",
        "equals": "dependabot.list"
      }
    },
    {
      "name": "severity",
      "kind": "text",
      "label": "심각도 (쉼표로 구분, 선택)",
      "placeholder": "critical, high",
      "showWhen": {
        "field": "mode",
        "equals": "dependabot.list"
      }
    },
    {
      "name": "ecosystem",
      "kind": "text",
      "label": "생태계 (쉼표로 구분, 선택)",
      "placeholder": "npm, pip, maven",
      "showWhen": {
        "field": "mode",
        "equals": "dependabot.list"
      }
    },
    {
      "name": "perPage",
      "kind": "number",
      "label": "가져올 개수 (최대 100)",
      "default": 30,
      "showWhen": {
        "field": "mode",
        "equals": "dependabot.list"
      },
      "validation": [
        {
          "rule": "number",
          "message": "{node_id}(githubNode)의 perPage는 숫자여야 한다"
        }
      ]
    }
  ],
  "credentials": [
    {
      "name": "github",
      "provider": "github",
      "optional": false
    }
  ],
  "capabilities": [
    "network"
  ],
  "sideEffect": "external-write",
  "executor": "githubNode",
  "connector": {
    "service": "GitHub",
    "role": "action",
    "modes": [
      "issue.create",
      "issue.comment",
      "issue.labels",
      "issue.update",
      "pr.get",
      "pr.diff",
      "pr.merge",
      "pr.comment",
      "release.create",
      "release.generate_notes",
      "workflow.dispatch",
      "dependabot.list",
      "file.get"
    ],
    "credentials": [
      {
        "provider": "github",
        "scopes": []
      }
    ],
    "baseUrl": "https://api.github.com",
    "timeoutSeconds": 20.0,
    "rateLimit": {
      "requestsPerMinute": 60
    },
    "retryPolicy": {
      "maxAttempts": 3,
      "baseDelaySeconds": 1.0,
      "maxDelaySeconds": 30.0
    },
    "sideEffectByMode": {
      "issue.create": "external-write",
      "issue.comment": "external-write",
      "issue.labels": "external-write",
      "issue.update": "external-write",
      "pr.get": "external-read",
      "pr.diff": "external-read",
      "pr.merge": "external-write",
      "pr.comment": "external-write",
      "release.create": "external-write",
      "release.generate_notes": "external-read",
      "workflow.dispatch": "external-write",
      "dependabot.list": "external-read",
      "file.get": "external-read"
    },
    "outputSchemaByMode": {
      "issue.create": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "pr.get": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          },
          "merged": {
            "type": "boolean"
          },
          "mergeable": {
            "type": "boolean"
          },
          "author": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "baseBranch": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "additions": {
            "type": "number"
          },
          "deletions": {
            "type": "number"
          },
          "changedFiles": {
            "type": "number"
          }
        }
      },
      "pr.diff": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "diff": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "release.generate_notes": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "dependabot.list": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "alerts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "number"
                },
                "state": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "package": {
                  "type": "string"
                },
                "ecosystem": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "file.get": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "sha": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    },
    "docsUrl": "https://docs.github.com/en/rest?apiVersion=2022-11-28",
    "verifiedAt": "2026-09-13"
  },
  "mock": {
    "scenarios": {
      "success": {
        "responses": [
          {
            "match": {
              "method": "POST",
              "urlContains": "/releases/generate-notes"
            },
            "status": 200,
            "body": {
              "name": "v2.3.0",
              "body": "## What's Changed\n* 결제 재시도 추가 by @octocat in https://github.com/acme/site/pull/42\n* 쿠폰 적용 오류 수정 by @jane-doe in https://github.com/acme/site/pull/41\n\n**Full Changelog**: https://github.com/acme/site/compare/v2.2.0...v2.3.0"
            }
          },
          {
            "match": {
              "method": "POST",
              "urlContains": "/releases"
            },
            "status": 201,
            "body": {
              "id": 1234567,
              "tag_name": "v2.3.0",
              "name": "v2.3.0",
              "html_url": "https://github.com/acme/site/releases/tag/v2.3.0",
              "draft": false,
              "prerelease": false,
              "body": "릴리스 노트"
            }
          },
          {
            "match": {
              "method": "POST",
              "urlContains": "/dispatches"
            },
            "status": 204,
            "body": ""
          },
          {
            "match": {
              "method": "GET",
              "urlContains": "/dependabot/alerts"
            },
            "status": 200,
            "body": [
              {
                "number": 3,
                "state": "open",
                "html_url": "https://github.com/acme/site/security/dependabot/3",
                "created_at": "2026-09-01T09:12:00Z",
                "security_advisory": {
                  "ghsa_id": "GHSA-xxxx-yyyy-zzzz",
                  "summary": "Prototype Pollution in lodash",
                  "severity": "high"
                },
                "dependency": {
                  "package": {
                    "ecosystem": "npm",
                    "name": "lodash"
                  },
                  "manifest_path": "package-lock.json"
                },
                "security_vulnerability": {
                  "vulnerable_version_range": "< 4.17.21",
                  "first_patched_version": {
                    "identifier": "4.17.21"
                  }
                }
              }
            ]
          },
          {
            "match": {
              "method": "GET",
              "urlContains": "/contents/"
            },
            "status": 200,
            "body": {
              "type": "file",
              "name": "README.md",
              "path": "README.md",
              "sha": "3d21ec53a331a6f037a91c368710b99387d012c1",
              "size": 46,
              "encoding": "base64",
              "content": "IyBhY21lL3NpdGUKCuqyveygnCDsg5zsnbTtirgg7ZSE66Gg7Yq47JeU65OcCg==\n",
              "html_url": "https://github.com/acme/site/blob/main/README.md"
            }
          },
          {
            "match": {
              "method": "PUT",
              "urlContains": "/merge"
            },
            "status": 200,
            "body": {
              "sha": "6dcb09b5b57875f334f61aebed695e2e4193db5e",
              "merged": true,
              "message": "Pull Request successfully merged"
            }
          },
          {
            "match": {
              "method": "GET",
              "urlContains": "/pulls/",
              "headerEquals": {
                "Accept": "application/vnd.github.diff"
              }
            },
            "status": 200,
            "body": "diff --git a/src/login.js b/src/login.js\nindex 83db48f..bf12a3c 100644\n--- a/src/login.js\n+++ b/src/login.js\n@@ -1,3 +1,8 @@\n+const EMAIL_RE = /^[^@\\s]+@[^@\\s]+$/;\n+export function validate(email, password) {\n+  return EMAIL_RE.test(email) && password.length >= 8;\n+}\n"
          },
          {
            "match": {
              "method": "GET",
              "urlContains": "/pulls/"
            },
            "status": 200,
            "body": {
              "number": 42,
              "title": "로그인 폼 유효성 검사 추가",
              "body": "이메일 형식과 비밀번호 길이를 검사합니다.",
              "state": "open",
              "draft": false,
              "merged": false,
              "mergeable": true,
              "html_url": "https://github.com/acme/site/pull/42",
              "user": {
                "login": "octocat"
              },
              "head": {
                "ref": "feature/login-validation",
                "sha": "6dcb09b5b57875f334f61aebed695e2e4193db5e"
              },
              "base": {
                "ref": "main"
              },
              "labels": [
                {
                  "name": "enhancement"
                }
              ],
              "additions": 120,
              "deletions": 8,
              "changed_files": 3
            }
          },
          {
            "match": {
              "method": "DELETE",
              "urlContains": "/labels/"
            },
            "status": 200,
            "body": [
              {
                "name": "enhancement"
              }
            ]
          },
          {
            "match": {
              "method": "POST",
              "urlContains": "/labels"
            },
            "status": 200,
            "body": [
              {
                "name": "enhancement"
              },
              {
                "name": "bug"
              }
            ]
          },
          {
            "match": {
              "method": "PUT",
              "urlContains": "/labels"
            },
            "status": 200,
            "body": [
              {
                "name": "bug"
              }
            ]
          },
          {
            "match": {
              "method": "POST",
              "urlContains": "/comments"
            },
            "status": 201,
            "body": {
              "id": 1,
              "html_url": "https://github.com/acme/site/issues/57#issuecomment-1",
              "body": "확인했습니다. 재현 후 수정 예정입니다.",
              "user": {
                "login": "acme-bot"
              }
            }
          },
          {
            "match": {
              "method": "PATCH",
              "urlContains": "/issues/"
            },
            "status": 200,
            "body": {
              "number": 57,
              "title": "결제 페이지에서 500 오류",
              "state": "closed",
              "html_url": "https://github.com/acme/site/issues/57",
              "labels": [
                {
                  "name": "bug"
                }
              ]
            }
          },
          {
            "match": {
              "method": "POST",
              "urlContains": "/issues"
            },
            "status": 201,
            "body": {
              "number": 58,
              "title": "새 이슈",
              "state": "open",
              "html_url": "https://github.com/acme/site/issues/58",
              "labels": []
            }
          }
        ]
      },
      "auth_failed": {
        "responses": [
          {
            "status": 401,
            "body": {
              "message": "Bad credentials",
