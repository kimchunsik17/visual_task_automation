{
  "type": "doorayNode",
  "version": 1,
  "category": "integration",
  "display": {
    "label": "Dooray 발송",
    "icon": "provider-dooray",
    "color": "#3F6EF5"
  },
  "inputs": [
    {
      "name": "in",
      "dataType": "any"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "dataType": "text"
    }
  ],
  "fields": [
    {
      "name": "message",
      "kind": "textarea",
      "label": "메시지 (비우면 직전 노드 출력, 채우면 뒤에 직전 출력을 덧붙임)",
      "placeholder": "{{last_result}} 로 자리를 정할 수도 있습니다",
      "ui": {
        "draggable": true
      }
    },
    {
      "name": "title",
      "kind": "text",
      "label": "첨부 제목 (선택)",
      "placeholder": "예: 배포 완료 — v2.3.0"
    },
    {
      "name": "link",
      "kind": "text",
      "label": "제목 링크 (선택)",
      "placeholder": "https://…"
    },
    {
      "name": "color",
      "kind": "select",
      "label": "색",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "기본"
        },
        {
          "value": "green",
          "label": "초록"
        },
        {
          "value": "blue",
          "label": "파랑"
        },
        {
          "value": "yellow",
          "label": "노랑"
        },
        {
          "value": "red",
          "label": "빨강"
        },
        {
          "value": "gray",
          "label": "회색"
        }
      ]
    },
    {
      "name": "botName",
      "kind": "text",
      "label": "보내는 봇 이름 (선택)",
      "placeholder": "Workflow AI"
    }
  ],
  "credentials": [
    {
      "name": "dooray_webhook",
      "provider": "dooray_webhook",
      "optional": false
    }
  ],
  "capabilities": [
    "network"
  ],
  "sideEffect": "external-write",
  "executor": "doorayNode",
  "connector": {
    "service": "Dooray",
    "role": "action",
    "modes": [
      "send"
    ],
    "credentials": [
      {
        "provider": "dooray_webhook",
        "scopes": []
      }
    ],
    "timeoutSeconds": 10.0,
    "retryPolicy": {
      "maxAttempts": 2,
      "baseDelaySeconds": 1.0,
      "maxDelaySeconds": 10.0
    },
    "sideEffectByMode": {
      "send": "external-write"
    },
    "docsUrl": "https://helpdesk.dooray.com/"
  },
  "mock": {
    "scenarios": {
      "success": {
        "responses": [
          {
            "status": 200,
            "body": {
              "header": {
                "isSuccessful": true,
                "resultCode": 0,
                "resultMessage": ""
              }
            }
          }
        ]
      },
      "auth_failed": {
        "responses": [
          {
            "status": 401,
            "body": {
              "header": {
                "isSuccessful": false,
                "resultCode": -300401,
                "resultMessage": "Unauthorized"
              }
            }
          }
        ]
      },
      "rate_limited": {
        "responses": [
          {
            "status": 429,
            "headers": {
              "Retry-After": "10"
            },
            "body": {
              "header": {
                "isSuccessful": false,
                "resultCode": -300429,
                "resultMessage": "Too Many Requests"
              }
            }
          }
        ]
      },
      "timeout": {
        "responses": [
          {
            "raise": "timeout"
          }
        ]
      }
    }
  },
  "llm": {
    "description": "NHN Dooray 메신저 채널에 메시지를 보낸다(Incoming Webhook). Slack 발송과 같은 규약 — data.message(문자열, 선택)를 비우면 직전 노드 출력을 보내고,\n                   채우면 메시지 뒤에 직전 출력을 덧붙인다({{last_result}} 로 자리를 정할 수도 있다). data.title(문자열, 선택 — 첨부 제목), data.link(문자열, 선택 — 제목 링크),\n                   data.color(\"green\"|\"blue\"|\"yellow\"|\"red\"|\"gray\", 선택), data.botName(문자열, 선택). API 센터에 'Dooray Incoming Webhook URL' 이 등록되어 있어야 한다.\n                   출력은 실제로 보낸 메시지 텍스트. 공공기관·기업 협업툴 알림에 쓴다.\n"
  }
}
