# Database Connection (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
# If empty or not set, it will fallback to a local SQLite for testing if configured,
# or you must provide a valid postgres URL.
DATABASE_URL=sqlite:///./sql_app.db

# Authentication and at-rest credential encryption. Use independent long random values in production.
#
# JWT_SECRET 은 **필수**다 — 비어 있으면 서버가 뜨지 않는다. 예전에는 'super-secret-key' 로
# 조용히 폴백해서, 넣는 것을 잊으면 공개된 문자열로 토큰에 서명했다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ⚠️ 이미 운영 중인 서비스에서 JWT_SECRET 을 바꾸면 user_api_keys 의 자격증명이 복호화
# 불가가 된다(CREDENTIAL_ENCRYPTION_KEY 가 없을 때 credential_crypto 가 JWT_SECRET 으로
# 폴백한다). 재암호화 스크립트는 저장소에 없다. 바꾸려면 CREDENTIAL_ENCRYPTION_KEY 를 먼저
# 독립된 값으로 넣고 기존 자격증명을 옮긴 뒤에 한다.
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Upload resource limits. Values are bytes/file counts.
MAX_UPLOAD_BYTES=10485760
MAX_CONTEXT_FILE_BYTES=10485760
MAX_CONTEXT_FILES=5


# Gemini API Key for LangGraph nodes
GEMINI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# OpenAI API Key for ChatGPT models
OPENAI_API_KEY=

# Shared LLM provider configuration
# Hosted OpenAI: LLM_PROVIDER=openai
# Local/OpenAI-compatible: LLM_PROVIDER=openai_compatible and set LLM_BASE_URL
# Offline tests: LLM_PROVIDER=mock and optionally set LLM_MOCK_RESPONSE
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# provider: use LLM_PROVIDER directly; local: local only; hybrid: local first with hosted fallback.
LLM_ROUTING_MODE=provider
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL_FAST=
LLM_LOCAL_MODEL_BALANCED=
LLM_LOCAL_MODEL_QUALITY=
LLM_LOCAL_TRAFFIC_PERCENT=100
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_HIGH_RISK_FORCE_HOSTED=true
LLM_HIGH_RISK_KEYWORDS=
LOCAL_BENCHMARK_MODELS=
LOCAL_BENCHMARK_MAX_TOKENS=100000
LLM_TASK_SPEC_TIMEOUT_SECONDS=20
LLM_GENERATION_MAX_ATTEMPTS=3
LLM_GENERATION_TIMEOUT_SECONDS=75
LLM_REPAIR_MAX_OPERATIONS=12
LLM_FINAL_REPAIR_MAX_ATTEMPTS=2
LLM_FINAL_REPAIR_TIMEOUT_SECONDS=30
LLM_GENERATION_FALLBACK_TIMEOUT_SECONDS=75
EVALUATION_RATE_LIMIT_RETRIES=2
# Evaluation cost guard: smoke is the default; full must be requested explicitly.
EVALUATION_DEFAULT_PROFILE=smoke
EVALUATION_SMOKE_CASE_IDS=1,6,28
EVALUATION_TARGETED_MAX_CASES=5
EVALUATION_MAX_TOTAL_TOKENS=60000
EVALUATION_FULL_MAX_TOTAL_TOKENS=500000
EVALUATION_ESTIMATED_CASE_TOKENS=20000
EVALUATION_CACHE_ENABLED=true
# Generation traces store hashes and graph shape by default. Enable only in controlled environments.
GENERATION_TRACE_STORE_CONTENT=false
# Dedicated HMAC salt for graph fingerprints. Use a long random value in production.
GENERATION_TRACE_HASH_SALT=
# Requires both this server switch and per-request user consent.
LLM_TRAINING_DATA_COLLECTION_ENABLED=false
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_BALANCED=gpt-5.4-mini
LLM_MODEL_QUALITY=gpt-5.3-chat-latest
LLM_MODEL_EVALUATION=gpt-4o-mini
LLM_MODEL_TITLE=gpt-4o-mini

# Workflow llmNode routing: auto, openai_compatible, or local
LLM_EXECUTION_PROVIDER=auto
LLM_LOCAL_SUPPORTS_STRUCTURED_OUTPUT=true
LLM_LOCAL_SUPPORTS_TOOL_CALLING=true
LLM_LOCAL_SUPPORTS_IMAGE_INPUT=false
LLM_MOCK_RESPONSE={}

# Anthropic API Key for Claude models
ANTHROPIC_API_KEY=

# Admin user emails (comma separated, e.g. admin@example.com,user@example.com)
ADMIN_EMAILS=

# NodeError v1 (ADR-0016). Controls only how the client *displays* execution errors — structured
# error objects are always produced and always drive internal status decisions. Set to 0 to fall
# back to legacy text display if a client-side problem appears.
NODE_ERROR_V1=1

# Database Query v2 (ADR-0017). V2 resolves the API Center credential inside the executor, checks the
# SQL with an AST guard and binds named parameters. Set to 0 to fall back to the previous path.
DATABASE_QUERY_V2=1
# Egress policy: loopback / link-local / cloud-metadata addresses are always blocked. Private CIDRs
# (10/8, 172.16/12, 192.168/16, fc00::/7) are blocked unless this self-host flag is set.
DATABASE_QUERY_ALLOW_PRIVATE_HOSTS=0
# SQLite URIs read server-local files. Only tests/local development should enable this.
DATABASE_QUERY_ALLOW_SQLITE=0
# sslmode applied when the connection string does not specify one (require|prefer|verify-full).
DATABASE_QUERY_DEFAULT_SSLMODE=require

# Artifact delivery v1 (ADR-0018). Attachments are resolved from registered artifacts — ownership,
# project, TTL, storage root and content hash are all checked before any network call. Set to 0 to
# send text only. The old "scan the result string for uploads/..." path never comes back.
ARTIFACT_DELIVERY_V1=1
# Per-connector switches. Turn one off to disable that channel's attachments while text delivery
# keeps working (roll out order: resolver -> discord -> gmail -> smtp).
ARTIFACT_DELIVERY_DISCORD=1
ARTIFACT_DELIVERY_GMAIL=1
ARTIFACT_DELIVERY_SMTP=1
# One-release migration adapter: converts `uploads/...` strings left in older graphs into artifact
# bindings, but only when the path resolves to a registered artifact owned by the same user.
ARTIFACT_DELIVERY_LEGACY_PATHS=1
# Google Drive download (ADR-0018 follow-up). Files fetched from Drive are streamed to disk and
# registered as artifacts, so they count against the user's upload quota — keep this well below
# MAX_DRIVE_UPLOAD_BYTES. Oversized responses are cut off mid-stream, not after landing on disk.
MAX_DRIVE_DOWNLOAD_BYTES=26214400

# pythonNode isolation (ADR-0019). The allowlist in workflow_security.py controls WHAT the code can
# reach; these control HOW MUCH it may spend. User code runs in a separate process under RLIMIT_CPU /
# RLIMIT_AS with a wall-clock timeout, and never sees this process's environment or the DB session.
# Turning isolation off keeps the allowlist and the static bomb filter — it only restores inline exec.
PYTHON_NODE_ISOLATION=1
PYTHON_NODE_CPU_SECONDS=1
PYTHON_NODE_MEMORY_BYTES=268435456
PYTHON_NODE_WALL_SECONDS=2
PYTHON_NODE_OUTPUT_BYTES=262144

# Community safety (ADR-0020). Rate limits are counted in PostgreSQL, not in process memory: with
# more than one uvicorn worker an in-memory counter silently multiplies the limit by the worker
# count, and restarts reset it. ADMIN_EMAILS now only bootstraps the first admin at startup —
# afterwards roles live in users.role so moderation actions can record who acted.
COMMUNITY_RATE_LIMIT=1
# Per-action overrides, e.g. RATE_LIMIT_POST_CREATE=20 (defaults live in rate_limit.DEFAULT_RULES).

# Messaging (ADR-0022). Friends-only 1:1 messages with SSE delivery. The stream re-reads the DB on
# every wake-up, so the in-process broker is only a latency optimisation — messages survive multiple
# uvicorn workers (worst-case delay is one heartbeat).
# ⚠️ nginx must not buffer this endpoint. The response carries `X-Accel-Buffering: no`; if you front
# it with something else, disable response buffering for /api/messages/stream or events arrive late.
MESSAGING_V1=1

# Community templates (ADR-0023). Publishing requires a successful run of the workflow in the
# author's own account — the cheapest quality gate we have, since it needs no human review.
# Ranking uses first-run success rate, not install counts (install counts are trivial to inflate).
TEMPLATE_V1=1

# Workspaces / RBAC (ADR-0024). Turning this off drops workspace membership from the permission
# check — projects fall back to personal ownership, which is how they behaved before workspaces.
# The permission function itself (project_access.can) works either way.
WORKSPACE_V1=1

# OAuth 동의 절차에서 provider 가 사용자를 돌려보낼 주소의 기준(한국형 노드 계획 Phase 0).
# 쉼표로 여러 개를 둘 수 있고 첫 번째가 기본값이다. provider 콘솔에는
# <base>/api/oauth/<provider>/callback 을 그대로 등록해야 한다.
OAUTH_REDIRECT_BASE_URL=https://wa-pnu.duckdns.org
