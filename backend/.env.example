# Database Connection (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
# If empty or not set, it will fallback to a local SQLite for testing if configured,
# or you must provide a valid postgres URL.
DATABASE_URL=sqlite:///./sql_app.db


# Gemini API Key for LangGraph nodes
GEMINI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# OpenAI API Key for ChatGPT models
OPENAI_API_KEY=

# Shared LLM provider configuration
# Hosted OpenAI: LLM_PROVIDER=openai
# Local/OpenAI-compatible: LLM_PROVIDER=openai_compatible and set LLM_BASE_URL
# Offline tests: LLM_PROVIDER=mock and optionally set LLM_MOCK_RESPONSE
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# provider: use LLM_PROVIDER directly; local: local only; hybrid: local first with hosted fallback.
LLM_ROUTING_MODE=provider
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL_FAST=
LLM_LOCAL_MODEL_BALANCED=
LLM_LOCAL_MODEL_QUALITY=
LLM_LOCAL_TRAFFIC_PERCENT=100
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_HIGH_RISK_FORCE_HOSTED=true
LLM_HIGH_RISK_KEYWORDS=
LOCAL_BENCHMARK_MODELS=
LOCAL_BENCHMARK_MAX_TOKENS=100000
LLM_TASK_SPEC_TIMEOUT_SECONDS=20
LLM_GENERATION_MAX_ATTEMPTS=3
LLM_GENERATION_TIMEOUT_SECONDS=75
LLM_REPAIR_MAX_OPERATIONS=12
LLM_FINAL_REPAIR_MAX_ATTEMPTS=2
LLM_FINAL_REPAIR_TIMEOUT_SECONDS=30
LLM_GENERATION_FALLBACK_TIMEOUT_SECONDS=75
EVALUATION_RATE_LIMIT_RETRIES=2
# Evaluation cost guard: smoke is the default; full must be requested explicitly.
EVALUATION_DEFAULT_PROFILE=smoke
EVALUATION_SMOKE_CASE_IDS=1,6,28
EVALUATION_TARGETED_MAX_CASES=5
EVALUATION_MAX_TOTAL_TOKENS=60000
EVALUATION_FULL_MAX_TOTAL_TOKENS=500000
EVALUATION_ESTIMATED_CASE_TOKENS=20000
EVALUATION_CACHE_ENABLED=true
# Generation traces store hashes and graph shape by default. Enable only in controlled environments.
GENERATION_TRACE_STORE_CONTENT=false
# Dedicated HMAC salt for graph fingerprints. Use a long random value in production.
GENERATION_TRACE_HASH_SALT=
# Requires both this server switch and per-request user consent.
LLM_TRAINING_DATA_COLLECTION_ENABLED=false
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_BALANCED=gpt-5.4-mini
LLM_MODEL_QUALITY=gpt-5.3-chat-latest
LLM_MODEL_EVALUATION=gpt-4o-mini
LLM_MODEL_TITLE=gpt-4o-mini

# Workflow llmNode routing: auto, openai_compatible, or local
LLM_EXECUTION_PROVIDER=auto
LLM_LOCAL_SUPPORTS_STRUCTURED_OUTPUT=true
LLM_LOCAL_SUPPORTS_TOOL_CALLING=true
LLM_LOCAL_SUPPORTS_IMAGE_INPUT=false
LLM_MOCK_RESPONSE={}

# Anthropic API Key for Claude models
ANTHROPIC_API_KEY=

# Admin user emails (comma separated, e.g. admin@example.com,user@example.com)
ADMIN_EMAILS=
