{
  "version": 1,
  "id": "event-poster",
  "name": "행사 포스터",
  "description": "행사 제목·일시·장소·소개를 담는 A4 세로 포스터. 색과 글꼴은 테마로 변경",
  "layout": "design",
  "output": {
    "default": "png",
    "allowed": [
      "png",
      "pdf"
    ]
  },
  "fields": [
    {
      "name": "eventTitle",
      "label": "행사 제목",
      "kind": "text",
      "required": true,
      "example": "2026 가을 개발자 밋업"
    },
    {
      "name": "tagline",
      "label": "부제",
      "kind": "text",
      "required": false,
      "example": "자동화의 밤"
    },
    {
      "name": "dateTime",
      "label": "일시",
      "kind": "text",
      "required": true,
      "example": "10월 24일(토) 19:00"
    },
    {
      "name": "place",
      "label": "장소",
      "kind": "text",
      "required": true,
      "example": "서울 성수 카페 온움"
    },
    {
      "name": "descriptionText",
      "label": "소개",
      "kind": "multiline",
      "required": false
    },
    {
      "name": "hostName",
      "label": "주최",
      "kind": "text",
      "required": false
    },
    {
      "name": "contactInfo",
      "label": "신청·문의",
      "kind": "text",
      "required": false,
      "example": "신청: forms.example.com · 문의: hello@example.com"
    },
    {
      "name": "mainImage",
      "label": "메인 이미지",
      "kind": "image",
      "required": false
    }
  ],
  "design": {
    "width": 794,
    "height": 1123,
    "theme": {
      "primaryColor": "#4f7cff",
      "backgroundColor": "#0e1424",
      "textColor": "#f5f7ff",
      "mutedColor": "#93a0c4",
      "fontFamily": "Pretendard"
    },
    "elements": [
      {
        "id": "host",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "primaryColor",
        "lineHeight": 1.45,
        "text": "{{hostName}}",
        "x": 56,
        "y": 52,
        "w": 400,
        "h": 30,
        "fontSize": 15,
        "letterSpacing": ".08em"
      },
      {
        "id": "hero",
        "kind": "image",
        "field": "mainImage",
        "radius": 18,
        "x": 56,
        "y": 100,
        "w": 682,
        "h": 330
      },
      {
        "id": "title",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "textColor",
        "lineHeight": 1.16,
        "text": "{{eventTitle}}",
        "x": 56,
        "y": 460,
        "w": 682,
        "h": 150,
        "fontSize": 60
      },
      {
        "id": "tagline",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "primaryColor",
        "lineHeight": 1.45,
        "text": "{{tagline}}",
        "x": 56,
        "y": 616,
        "w": 682,
        "h": 40,
        "fontSize": 26
      },
      {
        "id": "desc",
        "kind": "text",
        "bold": false,
        "align": "left",
        "color": "mutedColor",
        "lineHeight": 1.7,
        "text": "{{descriptionText}}",
        "x": 56,
        "y": 670,
        "w": 682,
        "h": 168,
        "fontSize": 17
      },
      {
        "id": "meta1",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "textColor",
        "lineHeight": 1.45,
        "text": "일시  {{dateTime}}",
        "x": 56,
        "y": 880,
        "w": 682,
        "h": 34,
        "fontSize": 20
      },
      {
        "id": "meta2",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "textColor",
        "lineHeight": 1.45,
        "text": "장소  {{place}}",
        "x": 56,
        "y": 924,
        "w": 682,
        "h": 34,
        "fontSize": 20
      },
      {
        "id": "contact",
        "kind": "text",
        "bold": false,
        "align": "left",
        "color": "mutedColor",
        "lineHeight": 1.45,
        "text": "{{contactInfo}}",
        "x": 56,
        "y": 1030,
        "w": 682,
        "h": 40,
        "fontSize": 15
      }
    ],
    "html": "<div class=\"cv\"><div class=\"e e1\">{{hostName}}</div><img data-field=\"mainImage\" class=\"e e2\"><div class=\"e e3\">{{eventTitle}}</div><div class=\"e e4\">{{tagline}}</div><div class=\"e e5\">{{descriptionText}}</div><div class=\"e e6\">일시  {{dateTime}}</div><div class=\"e e7\">장소  {{place}}</div><div class=\"e e8\">{{contactInfo}}</div></div>",
    "css": ".cv{position:absolute;left:0;top:0;width:100%;height:100%;overflow:hidden;background:var(--fs-backgroundColor);color:var(--fs-textColor);}\n.cv .e{position:absolute;box-sizing:border-box;margin:0;white-space:pre-wrap;word-break:keep-all;}\n.cv .e1{left:56px;top:52px;width:400px;height:30px;font-size:15px;font-weight:700;text-align:left;color:var(--fs-primaryColor);line-height:1.45;letter-spacing:.08em;}\n.cv .e2{left:56px;top:100px;width:682px;height:330px;object-fit:cover;border-radius:18px;}\n.cv .e3{left:56px;top:460px;width:682px;height:150px;font-size:60px;font-weight:700;text-align:left;color:var(--fs-textColor);line-height:1.16;}\n.cv .e4{left:56px;top:616px;width:682px;height:40px;font-size:26px;font-weight:700;text-align:left;color:var(--fs-primaryColor);line-height:1.45;}\n.cv .e5{left:56px;top:670px;width:682px;height:168px;font-size:17px;font-weight:400;text-align:left;color:var(--fs-mutedColor);line-height:1.7;}\n.cv .e6{left:56px;top:880px;width:682px;height:34px;font-size:20px;font-weight:700;text-align:left;color:var(--fs-textColor);line-height:1.45;}\n.cv .e7{left:56px;top:924px;width:682px;height:34px;font-size:20px;font-weight:700;text-align:left;color:var(--fs-textColor);line-height:1.45;}\n.cv .e8{left:56px;top:1030px;width:682px;height:40px;font-size:15px;font-weight:400;text-align:left;color:var(--fs-mutedColor);line-height:1.45;}"
  }
}
