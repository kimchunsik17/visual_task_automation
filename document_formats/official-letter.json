{
  "version": 1,
  "id": "official-letter",
  "name": "공문",
  "description": "기관 간 주고받는 대외 공문서(수신·발신·제목·본문·붙임)",
  "layout": "document",
  "output": {
    "default": "hwpx",
    "allowed": [
      "hwpx",
      "docx",
      "pdf"
    ]
  },
  "fields": [
    {
      "name": "docNumber",
      "label": "문서 번호",
      "kind": "text",
      "required": true,
      "example": "워크-2026-041"
    },
    {
      "name": "sender",
      "label": "발신",
      "kind": "text",
      "required": true
    },
    {
      "name": "receiver",
      "label": "수신",
      "kind": "text",
      "required": true
    },
    {
      "name": "subject",
      "label": "제목",
      "kind": "text",
      "required": true
    },
    {
      "name": "body",
      "label": "본문",
      "kind": "multiline",
      "required": true
    },
    {
      "name": "attachmentsNote",
      "label": "붙임",
      "kind": "text",
      "required": false,
      "example": "1. 사업 계획서 1부. 끝."
    },
    {
      "name": "date",
      "label": "시행일",
      "kind": "text",
      "required": true
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "text": "{{sender}}"
    },
    {
      "type": "table",
      "columns": [
        "항목",
        "내용"
      ],
      "rows": [
        [
          "문서 번호",
          "{{docNumber}}"
        ],
        [
          "시행일",
          "{{date}}"
        ],
        [
          "수신",
          "{{receiver}}"
        ],
        [
          "제목",
          "{{subject}}"
        ]
      ]
    },
    {
      "type": "paragraph",
      "text": "1. 귀 기관의 무궁한 발전을 기원합니다."
    },
    {
      "type": "paragraph",
      "text": "{{body}}"
    },
    {
      "type": "paragraph",
      "text": "붙임  {{attachmentsNote}}"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "{{sender}}"
    }
  ]
}
