{
  "version": 1,
  "id": "tri-fold-pamphlet",
  "name": "3단 팜플렛",
  "description": "A4 가로를 3단으로 나눈 안내 팜플렛(제품·서비스 소개)",
  "layout": "design",
  "output": {
    "default": "pdf",
    "allowed": [
      "pdf",
      "png"
    ]
  },
  "fields": [
    {
      "name": "brandName",
      "label": "브랜드/제품명",
      "kind": "text",
      "required": true
    },
    {
      "name": "headline",
      "label": "대표 문구",
      "kind": "text",
      "required": true
    },
    {
      "name": "panel1Title",
      "label": "1면 제목",
      "kind": "text",
      "required": true
    },
    {
      "name": "panel1Body",
      "label": "1면 내용",
      "kind": "multiline",
      "required": true
    },
    {
      "name": "panel2Title",
      "label": "2면 제목",
      "kind": "text",
      "required": true
    },
    {
      "name": "panel2Body",
      "label": "2면 내용",
      "kind": "multiline",
      "required": true
    },
    {
      "name": "contact",
      "label": "연락처/웹",
      "kind": "text",
      "required": true
    },
    {
      "name": "coverImage",
      "label": "표지 이미지",
      "kind": "image",
      "required": false
    }
  ],
  "design": {
    "width": 1123,
    "height": 794,
    "theme": {
      "primaryColor": "#0f766e",
      "backgroundColor": "#ffffff",
      "textColor": "#0f172a",
      "mutedColor": "#5b6474",
      "fontFamily": "Pretendard"
    },
    "elements": [
      {
        "id": "p1title",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "primaryColor",
        "lineHeight": 1.45,
        "text": "{{panel1Title}}",
        "x": 34,
        "y": 44,
        "w": 306,
        "h": 34,
        "fontSize": 22
      },
      {
        "id": "p1body",
        "kind": "text",
        "bold": false,
        "align": "left",
        "color": "textColor",
        "lineHeight": 1.75,
        "text": "{{panel1Body}}",
        "x": 34,
        "y": 92,
        "w": 306,
        "h": 620,
        "fontSize": 14
      },
      {
        "id": "p2title",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "primaryColor",
        "lineHeight": 1.45,
        "text": "{{panel2Title}}",
        "x": 408,
        "y": 44,
        "w": 306,
        "h": 34,
        "fontSize": 22
      },
      {
        "id": "p2body",
        "kind": "text",
        "bold": false,
        "align": "left",
        "color": "textColor",
        "lineHeight": 1.75,
        "text": "{{panel2Body}}",
        "x": 408,
        "y": 92,
        "w": 306,
        "h": 560,
        "fontSize": 14
      },
      {
        "id": "contact",
        "kind": "text",
        "bold": true,
        "align": "left",
        "color": "mutedColor",
        "lineHeight": 1.45,
        "text": "{{contact}}",
        "x": 408,
        "y": 700,
        "w": 306,
        "h": 40,
        "fontSize": 14
      },
      {
        "id": "brand",
        "kind": "text",
        "bold": true,
        "align": "center",
        "color": "primaryColor",
        "lineHeight": 1.45,
        "text": "{{brandName}}",
        "x": 782,
        "y": 150,
        "w": 306,
        "h": 26,
        "fontSize": 15,
        "letterSpacing": ".12em"
      },
      {
        "id": "cover",
        "kind": "image",
        "field": "coverImage",
        "radius": 14,
        "x": 782,
        "y": 196,
        "w": 306,
        "h": 280
      },
      {
        "id": "headline",
        "kind": "text",
        "bold": true,
        "align": "center",
        "color": "textColor",
        "lineHeight": 1.25,
        "text": "{{headline}}",
        "x": 782,
        "y": 500,
        "w": 306,
        "h": 130,
        "fontSize": 32
      }
    ],
    "html": "<div class=\"cv\"><div class=\"e e1\">{{panel1Title}}</div><div class=\"e e2\">{{panel1Body}}</div><div class=\"e e3\">{{panel2Title}}</div><div class=\"e e4\">{{panel2Body}}</div><div class=\"e e5\">{{contact}}</div><div class=\"e e6\">{{brandName}}</div><img data-field=\"coverImage\" class=\"e e7\"><div class=\"e e8\">{{headline}}</div></div>",
    "css": ".cv{position:absolute;left:0;top:0;width:100%;height:100%;overflow:hidden;background:var(--fs-backgroundColor);color:var(--fs-textColor);}\n.cv .e{position:absolute;box-sizing:border-box;margin:0;white-space:pre-wrap;word-break:keep-all;}\n.cv .e1{left:34px;top:44px;width:306px;height:34px;font-size:22px;font-weight:700;text-align:left;color:var(--fs-primaryColor);line-height:1.45;}\n.cv .e2{left:34px;top:92px;width:306px;height:620px;font-size:14px;font-weight:400;text-align:left;color:var(--fs-textColor);line-height:1.75;}\n.cv .e3{left:408px;top:44px;width:306px;height:34px;font-size:22px;font-weight:700;text-align:left;color:var(--fs-primaryColor);line-height:1.45;}\n.cv .e4{left:408px;top:92px;width:306px;height:560px;font-size:14px;font-weight:400;text-align:left;color:var(--fs-textColor);line-height:1.75;}\n.cv .e5{left:408px;top:700px;width:306px;height:40px;font-size:14px;font-weight:700;text-align:left;color:var(--fs-mutedColor);line-height:1.45;}\n.cv .e6{left:782px;top:150px;width:306px;height:26px;font-size:15px;font-weight:700;text-align:center;color:var(--fs-primaryColor);line-height:1.45;letter-spacing:.12em;}\n.cv .e7{left:782px;top:196px;width:306px;height:280px;object-fit:cover;border-radius:14px;}\n.cv .e8{left:782px;top:500px;width:306px;height:130px;font-size:32px;font-weight:700;text-align:center;color:var(--fs-textColor);line-height:1.25;}"
  }
}
