{
  "version": 1,
  "id": "certificate-award",
  "name": "상장·수료증",
  "description": "테두리 장식을 갖춘 가로 A4 상장/수료증 — 번호·성명·문구·수여 기관",
  "layout": "design",
  "output": {
    "default": "pdf",
    "allowed": [
      "pdf",
      "png"
    ]
  },
  "fields": [
    {
      "name": "certNumber",
      "label": "증서 번호",
      "kind": "text",
      "required": false,
      "example": "제 2026-07 호"
    },
    {
      "name": "certTitle",
      "label": "증서 제목",
      "kind": "text",
      "required": true,
      "example": "수 료 증"
    },
    {
      "name": "recipientOrg",
      "label": "소속",
      "kind": "text",
      "required": false,
      "example": "운영1팀"
    },
    {
      "name": "recipientName",
      "label": "성명",
      "kind": "text",
      "required": true,
      "example": "김 워 크"
    },
    {
      "name": "courseName",
      "label": "과정/수상 내용",
      "kind": "text",
      "required": true,
      "example": "AI 워크플로우 실무 과정"
    },
    {
      "name": "bodyText",
      "label": "본문 문구",
      "kind": "multiline",
      "required": true,
      "example": "위 사람은 본 기관이 주관한 위 과정을 성실히 이수하였기에 이 증서를 수여합니다."
    },
    {
      "name": "issueDate",
      "label": "수여일",
      "kind": "text",
      "required": true,
      "example": "2026년 9월 2일"
    },
    {
      "name": "issuerName",
      "label": "수여 기관/대표",
      "kind": "text",
      "required": true,
      "example": "워크플로우 아카데미 대표 이플로"
    }
  ],
  "design": {
    "width": 1123,
    "height": 794,
    "theme": {
      "primaryColor": "#b08d3e",
      "backgroundColor": "#fffdf6",
      "textColor": "#20242c",
      "mutedColor": "#6b6f78",
      "fontFamily": "Pretendard"
    },
    "elements": [
      {
        "id": "frame",
        "kind": "box",
        "borderColor": "primaryColor",
        "borderWidth": 3,
        "background": "",
        "radius": 0,
        "x": 34,
        "y": 34,
        "w": 1055,
        "h": 726
      },
      {
        "id": "frameInner",
        "kind": "box",
        "borderColor": "primaryColor",
        "borderWidth": 1,
        "background": "",
        "radius": 0,
        "x": 46,
        "y": 46,
        "w": 1031,
        "h": 702
      },
      {
        "id": "number",
        "kind": "text",
        "bold": false,
        "align": "left",
        "color": "mutedColor",
        "lineHeight": 1.45,
        "text": "{{certNumber}}",
        "x": 90,
        "y": 78,
        "w": 300,
        "h": 26,
        "fontSize": 16
      },
      {
        "id": "title",
        "kind": "text",
        "bold": true,
        "align": "center",
        "color": "textColor",
        "lineHeight": 1.45,
        "text": "{{certTitle}}",
        "x": 62,
        "y": 140,
        "w": 999,
        "h": 72,
        "fontSize": 54,
        "letterSpacing": ".5em"
      },
      {
        "id": "who",
        "kind": "text",
        "bold": true,
        "align": "center",
        "color": "textColor",
        "lineHeight": 1.45,
        "text": "{{recipientOrg}}   {{recipientName}}",
        "x": 62,
        "y": 272,
        "w": 999,
        "h": 46,
        "fontSize": 30
      },
      {
        "id": "course",
        "kind": "text",
        "bold": true,
        "align": "center",
        "color": "primaryColor",
        "lineHeight": 1.45,
        "text": "{{courseName}}",
        "x": 62,
        "y": 330,
        "w": 999,
        "h": 32,
        "fontSize": 21
      },
      {
        "id": "body",
        "kind": "text",
        "bold": false,
        "align": "center",
        "color": "textColor",
        "lineHeight": 1.9,
        "text": "{{bodyText}}",
        "x": 162,
        "y": 392,
        "w": 799,
        "h": 160,
        "fontSize": 19
      },
      {
        "id": "date",
        "kind": "text",
        "bold": false,
        "align": "center",
        "color": "textColor",
        "lineHeight": 1.45,
        "text": "{{issueDate}}",
        "x": 62,
        "y": 620,
        "w": 999,
        "h": 28,
        "fontSize": 18
      },
      {
        "id": "issuer",
        "kind": "text",
        "bold": true,
        "align": "center",
        "color": "textColor",
        "lineHeight": 1.45,
        "text": "{{issuerName}} (인)",
        "x": 62,
        "y": 664,
        "w": 999,
        "h": 36,
        "fontSize": 24,
        "letterSpacing": ".08em"
      }
    ],
    "html": "<div class=\"cv\"><div class=\"e e1\"></div><div class=\"e e2\"></div><div class=\"e e3\">{{certNumber}}</div><div class=\"e e4\">{{certTitle}}</div><div class=\"e e5\">{{recipientOrg}}   {{recipientName}}</div><div class=\"e e6\">{{courseName}}</div><div class=\"e e7\">{{bodyText}}</div><div class=\"e e8\">{{issueDate}}</div><div class=\"e e9\">{{issuerName}} (인)</div></div>",
    "css": ".cv{position:absolute;left:0;top:0;width:100%;height:100%;overflow:hidden;background:var(--fs-backgroundColor);color:var(--fs-textColor);}\n.cv .e{position:absolute;box-sizing:border-box;margin:0;white-space:pre-wrap;word-break:keep-all;}\n.cv .e1{left:34px;top:34px;width:1055px;height:726px;border:3px solid var(--fs-primaryColor);}\n.cv .e2{left:46px;top:46px;width:1031px;height:702px;border:1px solid var(--fs-primaryColor);}\n.cv .e3{left:90px;top:78px;width:300px;height:26px;font-size:16px;font-weight:400;text-align:left;color:var(--fs-mutedColor);line-height:1.45;}\n.cv .e4{left:62px;top:140px;width:999px;height:72px;font-size:54px;font-weight:700;text-align:center;color:var(--fs-textColor);line-height:1.45;letter-spacing:.5em;}\n.cv .e5{left:62px;top:272px;width:999px;height:46px;font-size:30px;font-weight:700;text-align:center;color:var(--fs-textColor);line-height:1.45;}\n.cv .e6{left:62px;top:330px;width:999px;height:32px;font-size:21px;font-weight:700;text-align:center;color:var(--fs-primaryColor);line-height:1.45;}\n.cv .e7{left:162px;top:392px;width:799px;height:160px;font-size:19px;font-weight:400;text-align:center;color:var(--fs-textColor);line-height:1.9;}\n.cv .e8{left:62px;top:620px;width:999px;height:28px;font-size:18px;font-weight:400;text-align:center;color:var(--fs-textColor);line-height:1.45;}\n.cv .e9{left:62px;top:664px;width:999px;height:36px;font-size:24px;font-weight:700;text-align:center;color:var(--fs-textColor);line-height:1.45;letter-spacing:.08em;}"
  }
}
