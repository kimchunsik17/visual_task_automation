{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d <CLONE_PATH>\\backend && venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d <CLONE_PATH>\\frontend && npm run dev"
      ],
      "port": 5173
    }
  ]
}
